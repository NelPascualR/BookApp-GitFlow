
<div class="mb-4">
    <a href="/" class="btn btn-outline-secondary">
        ← Volver al catálogo
    </a>
</div>

{{#if libro}}
    <div class="card shadow-sm">
        <div class="row g-0">
            <div class="col-md-4">
                <img
                    src="{{libro.coverUrl}}"
                    class="img-fluid rounded-start book-detail-cover"
                    alt="Portada de {{libro.title}}"
                >
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <h1 class="card-title">{{libro.title}}</h1>

                    <p><strong>Año de publicación:</strong> {{libro.publicationYear}}</p>
                    <p><strong>Categoría:</strong> {{libro.Category.name}}</p>
                    <p><strong>Autor:</strong> {{libro.Author.name}}</p>
                    <p><strong>Correo del autor:</strong> {{libro.Author.email}}</p>
                    <hr>

                    <h4>Información de la editorial</h4>
                    <p><strong>Nombre:</strong> {{libro.Publisher.name}}</p>
                    <p><strong>Teléfono:</strong> {{libro.Publisher.phone}}</p>
                    <p><strong>País:</strong> {{libro.Publisher.country}}</p>
                </div>
            </div>
        </div>
    </div>
{{else}}
    <div class="alert alert-warning">
        No se encontró el libro solicitado.
    </div>
{{/if}}
