
<div class="mb-4">
    <a href="/books/manage" class="btn btn-outline-secondary">
        ← Volver a administrar libros
    </a>
</div>

<h1 class="mb-4">Editar libro</h1>

{{#if error}}
    <div class="alert alert-danger">
        {{error}}
    </div>
{{/if}}

<form
    action="/books/{{libro.id}}?_method=PUT"
    method="POST"
    class="card card-body shadow-sm"
>
    <div class="mb-3">
        <label for="title" class="form-label">Título del libro</label>
        <input
            type="text"
            id="title"
            name="title"
            class="form-control"
            value="{{libro.title}}"
            required
        >
    </div>

    <div class="mb-3">
        <label for="publicationYear" class="form-label">
            Año de publicación
        </label>
        <input
            type="number"
            id="publicationYear"
            name="publicationYear"
            class="form-control"
            value="{{libro.publicationYear}}"
            required
        >
    </div>

    <div class="mb-3">
        <label for="coverUrl" class="form-label">URL de la portada</label>
        <input
            type="url"
            id="coverUrl"
            name="coverUrl"
            class="form-control"
            value="{{libro.coverUrl}}"
        >
        <small class="text-muted">
            Puedes conservar la portada actual o introducir otra URL.
        </small>
    </div>

    <div class="mb-3">
        <label for="categoryId" class="form-label">Categoría</label>
        <select id="categoryId" name="categoryId" class="form-select" required>
            <option value="{{libro.categoryId}}" selected>
                {{libro.Category.name}}
            </option>
            {{#each categorias}}
                <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="mb-3">
        <label for="authorId" class="form-label">Autor</label>
        <select id="authorId" name="authorId" class="form-select" required>
            <option value="{{libro.authorId}}" selected>
                {{libro.Author.name}}
            </option>
            {{#each autores}}
                <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="mb-3">
        <label for="publisherId" class="form-label">Editorial</label>
        <select id="publisherId" name="publisherId" class="form-select" required>
            <option value="{{libro.publisherId}}" selected>
                {{libro.Publisher.name}}
            </option>
            {{#each editoriales}}
                <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Guardar cambios
        </button>

        <a href="/books/manage" class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>
