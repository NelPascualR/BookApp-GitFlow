
<div class="mb-4">
    <a href="/publishers" class="btn btn-outline-secondary">
        ← Volver a editoriales
    </a>
</div>

<h1 class="mb-4">Editar editorial</h1>

{{#if error}}
    <div class="alert alert-danger">
        {{error}}
    </div>
{{/if}}

<form action="/publishers/{{editorial.id}}?_method=PUT" method="POST" class="card card-body shadow-sm">

    <div class="mb-3">
        <label for="name" class="form-label">Nombre de la editorial</label>
        <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            value="{{editorial.name}}"
            required
        >
    </div>

    <div class="mb-3">
        <label for="phone" class="form-label">Teléfono</label>
        <input
            type="tel"
            id="phone"
            name="phone"
            class="form-control"
            value="{{editorial.phone}}"
            required
        >
    </div>

    <div class="mb-3">
        <label for="country" class="form-label">País</label>
        <input
            type="text"
            id="country"
            name="country"
            class="form-control"
            value="{{editorial.country}}"
            required
        >
    </div>

    <button type="submit" class="btn btn-primary">
        Actualizar editorial
    </button>
</form>
